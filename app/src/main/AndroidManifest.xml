<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Deliberately NO <uses-permission> at all: no INTERNET, no storage (01-architecture §1, HARD RULE 1). -->

    <!--
      How to turn backup off (T11 pitfalls): allowBackup="false" stops only cloud backup. At targetSdk >= 31,
      device-to-device transfer still follows data_extraction_rules.xml. To stop both, replace every <include>
      in both sections of res/xml/data_extraction_rules.xml with <exclude domain="root" path="."/> plus the same
      exclude for file/database/sharedpref/external. `.trash/`, noBackupFilesDir (recovery) and the cache are
      never backed up either way (platform §2.13).
    -->
    <application
        android:name=".MdWriterApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MdWriter">
        <!-- android:enableOnBackInvokedCallback defaults to true at targetSdk 36+; never set it to false. -->

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              T18: open .md/.txt files from other apps. Deliberately NO android:BROWSABLE category anywhere in this
              file (hard rule 1 / platform §3.2) — mdwriter must never appear as a handler for a web link.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Fallback: sender says octet-stream or */*; pathSuffix matching needs scheme+host (platform §3.1). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="content"
                    android:host="*"
                    android:mimeType="*/*" />
                <data android:pathSuffix=".md" />
                <data android:pathSuffix=".markdown" />
                <data android:pathSuffix=".mdown" />
                <data android:pathSuffix=".mkd" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
            </intent-filter>
        </activity>

        <!-- T18: share-out (ShareOut copies the shared file under cacheDir/exports/ and grants a content:// Uri
             to it). Authority built from applicationId at build time — matches packageName at runtime for both
             the release app (me.gcg.mdwriter) and the debug app (me.gcg.mdwriter.debug, applicationIdSuffix). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
