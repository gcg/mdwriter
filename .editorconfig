root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
# T02 deviation (see plans/STATUS.md): compose-rules' custom EditorConfigProperty for the
# compositionlocal-allowlist check is only resolved by Spotless/ktlint 1.8.0 from the universal [*] section,
# not from a language-specific glob section such as [*.{kt,kts}] (verified empirically). Keep it here.
compose_allowed_composition_locals = LocalWriterColors,LocalWriterTypography

[*.{kt,kts}]
ktlint_code_style = ktlint_official
ktlint_function_naming_ignore_when_annotated_with = Composable
max_line_length = 120
ktlint_standard_if-else-wrapping = disabled

[*.{yml,yaml,json,toml,xml}]
indent_size = 2

# Make recipes MUST be indented with a real tab.
[{Makefile,*.mk}]
indent_style = tab
indent_size = 8

# Markdown: two trailing spaces are a hard line break.
[*.md]
trim_trailing_whitespace = false
